# Postgres connection string (use the pooled connection string in production)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Real OpenAI API key for production (chat roleplay + scoring)
OPENAI_API_KEY=sk-...

# Optional: override the default chat model (defaults to gpt-4o-mini)
OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional: customer voice playback speed for TTS (0.25–4.0, defaults to 1.12)
OPENAI_TTS_SPEED=1.12

NODE_ENV=production
PORT=5000

# --- Stripe billing ---
# Secret API key (use a sk_test_... key in test mode). Billing features are disabled
# gracefully if this is unset (demo accounts still work).
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret from `stripe listen` or the Dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...
# Per-tier Price IDs printed by `npx tsx scripts/stripe-setup.ts` (flat-per-tier v2).
# Consultant seat, one flat monthly rate per plan tier ($49 / $45 / $41).
STRIPE_SEAT_TEAM_PRICE_ID=price_...
STRIPE_SEAT_OFFICE_PRICE_ID=price_...
STRIPE_SEAT_COMPANY_PRICE_ID=price_...
# Optional Manager Dashboard, one flat monthly rate per plan tier ($249 / $389 / $529).
STRIPE_DASHBOARD_TEAM_PRICE_ID=price_...
STRIPE_DASHBOARD_OFFICE_PRICE_ID=price_...
STRIPE_DASHBOARD_COMPANY_PRICE_ID=price_...
# Enterprise (36+) is a custom quote — no self-serve price object.
# Base URL used for Checkout/Portal success & return redirects.
APP_URL=http://localhost:5000

# --- Lead notification emails (Resend) ---
# Required to send an email to hello@solveframework.com when a new lead is
# submitted via POST /api/leads. If unset, lead capture still works — the
# notification is skipped and a warning is logged.
RESEND_API_KEY=re_...

# --- Vapi voice pilot (ONE scenario: auto-sales-growing-family-suv) ---
# Additive pilot of Vapi as a replacement for the browser voice pipeline, which
# can cut reps off mid-sentence. Every variable below is optional: with none of
# them set, the pilot stays off and voice behaves exactly as it does today for
# every scenario.
#
# Server / setup script only (PRIVATE key — never expose to the browser):
# Vapi private API key, used by `npm run vapi:setup` to create/update the pilot
# assistants over the REST API. Not read by the app at runtime.
VAPI_API_KEY=
# Public HTTPS origin + path Vapi POSTs to for customer replies. Vapi treats this
# as an OpenAI baseURL and appends /chat/completions, so it must NOT include that
# suffix. Must be publicly reachable (Vapi's servers call it), so a tunnel URL is
# needed for local testing.
VAPI_CUSTOM_LLM_URL=https://your-public-host/api/vapi/auto-sales-growing-family-suv
# Optional. Set only if you have your OWN ElevenLabs voice available to Vapi via
# BYOK — Vapi has no key-free ElevenLabs voice library (see
# VAPI_PILOT_ASSISTANTS.md). Left empty, the A/B is between two Vapi platform
# voices, which need no extra credentials.
VAPI_ELEVENLABS_VOICE_ID=

# Browser (Vite) — all three must be set for the pilot to activate:
# Master flag. Anything other than 1/true/yes/on leaves the pilot off. A single
# tab can also opt in without a rebuild by visiting the roleplay page with
# ?vapi=1 (no localStorage is used anywhere).
VITE_VAPI_PILOT_ENABLED=
# Vapi PUBLIC key (safe in the browser; distinct from VAPI_API_KEY above).
VITE_VAPI_PUBLIC_KEY=
# Which assistant to dial. Swap between the two IDs printed in
# VAPI_PILOT_ASSISTANTS.md to compare the voices by ear.
VITE_VAPI_ASSISTANT_ID=
